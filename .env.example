# main.py가 실제로 읽는 환경변수 전부 (기본값 없는 것은 필수).
# .config/telegram-bot/.env 고정 경로가 있으면 그쪽을 우선 읽고, 없으면 실행 위치의 .env를 읽습니다.

# ── 텔레그램 계정 인증 (유저봇 — 봇 토큰이 아니라 실제 계정 로그인) ──
TELEGRAM_API_ID=                      # my.telegram.org 에서 발급 (필수)
TELEGRAM_API_HASH=                    # my.telegram.org 에서 발급 (필수, 비밀번호처럼 취급)
TELEGRAM_PHONE=                       # 국가번호 포함 (예: +8210xxxxxxxx), 없으면 최초 실행 시 콘솔 입력
SESSION_PATH=stock_dedup_session      # 로그인 세션 파일 경로 (최초 1회 로그인 후 재사용)

# ── 감시/전송 채널 ──
SOURCE_CHATS=                         # 감시할 채팅방 username(@ 없이) 또는 chat id, 콤마 구분 (필수)
DIGEST_CHAT=                          # 중복 제거된 결과를 보낼 채널 (필수)
SUMMARY_CHAT=                         # 일간 정리(06시/18시)를 보낼 채널 (선택, 비우면 DIGEST_CHAT과 동일)

# ── 알림/로그용 별도 Bot API 토큰 (유저봇 계정과는 별개) ──
TELEGRAM_BOT_TOKEN=                   # 결과 전송 등에 쓰는 Bot API 토큰 (선택)
LOG_BOT_TOKEN=                        # 실행 로그를 텔레그램으로 보낼 때 쓰는 봇 토큰 (선택)
LOG_CHAT_INFO=                        # INFO 레벨 로그를 받을 채널 (선택)
LOG_CHAT_WARNING=                     # WARNING 이상 로그를 받을 채널 (선택, 없으면 LOG_CHAT 사용)
LOG_CHAT=                             # LOG_CHAT_WARNING 미설정 시 대체값 (선택)

# ── LLM: 애매한 유사도 구간만 물어보는 최종 판단자 ──
LLM_PROVIDER=anthropic                # anthropic / openai / gemini
LLM_FALLBACK_PROVIDERS=               # 1차 provider 실패 시 순서대로 시도, 콤마 구분 (예: openai,gemini)
ANTHROPIC_API_KEY=                    # console.anthropic.com 에서 발급
CLAUDE_MODEL=claude-haiku-4-5-20251001
OPENAI_API_KEY=                       # LLM_PROVIDER 또는 폴백에 openai를 쓸 때만 필요
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=                       # 단일 키. GEMINI_API_KEYS가 있으면 이 값은 무시됨
GEMINI_API_KEYS=                      # 콤마로 여러 키 등록 시 요청마다 순환 사용 (rate limit 우회용)
GEMINI_MODEL=gemini-3-flash
GEMINI_PER_KEY_RPM=12                 # 키 1개당 분당 요청 제한 (무료 티어 15RPM보다 낮게 설정)
GEMINI_MAX_COOLDOWN_WAIT=5            # 모든 키가 쿨다운 중일 때 최대 대기 시간(초)
LLM_MAX_CALLS_PER_WINDOW=8            # 아래 윈도우(초) 동안 허용할 최대 LLM 호출 수
LLM_RATE_WINDOW_SECONDS=60

# ── 중복 판정 튜닝 ──
DEDUP_WINDOW_MINUTES=1440             # 이 시간(분) 내 메시지끼리만 비교 (기본 24시간)
KEYWORD_THRESHOLD_HIGH=0.6            # 이 이상이면 LLM 없이 바로 중복 확정
KEYWORD_THRESHOLD_LOW=0.25            # 이 이상 ~ HIGH 미만이면 LLM에게 재확인
MIN_KEYWORDS_FOR_AUTO_DUP=6           # 자동 확정에 필요한 최소 키워드 수 (짧은 캡션 오탐 방지)
MAX_LLM_DUP_CANDIDATES=3              # 애매한 후보 중 LLM에게 물어볼 최대 개수
MAX_AUTO_DUP_SIZE_RATIO=1.4           # 두 메시지 키워드 수 비율이 이보다 크면 자동 확정 안 함
URL_MATCH_SCORE_THRESHOLD=0.15        # 같은 URL 공유 시 이 이상이면 문구 비교 없이 즉시 중복
NUMBER_MATCH_TOLERANCE=0.001          # 숫자(가격 등) 비교 시 허용 오차율

# ── 채팅 필터/요약 ──
CHITCHAT_FILTER_ENABLED=true          # 주식과 무관한 잡담을 걸러낼지 여부
SUMMARIZE_ENABLED=false               # 전달 전 LLM 요약을 붙일지 여부

# ── 일간 정리(digest) ──
DAILY_DIGEST_ENABLED=false
DAILY_DIGEST_START_HOUR=6             # 오전 정리 시작 시각(KST, 24h)
DAILY_DIGEST_HOUR=18                  # 저녁 정리 발송 시각(KST, 24h)
NIGHT_DIGEST_END_HOUR=8               # 야간 정리 종료 시각(KST, 24h)
DIGEST_SENT_STATE_PATH=               # 발송 이력 저장 경로 (선택, 비우면 DB_PATH와 같은 폴더)

# ── 실적 캘린더 (Finnhub) ──
FINNHUB_API_KEY=                      # finnhub.io 에서 발급 (실적 발표 일정/검증용, 선택)
EARNINGS_REVIEW_DEDUP_DAYS=5          # 같은 종목 실적 리뷰 재중복 방지 기간(일)
REVIEWED_EARNINGS_STATE_PATH=         # 실적 리뷰 이력 저장 경로 (선택)

# ── 기타 경로/운영 ──
DB_PATH=dedup_history.db
TEMP_MEDIA_DIR=                       # 미디어 임시 저장 폴더 (선택, 비우면 시스템 temp 사용)
PROCESSED_ID_RETENTION_HOURS=2        # 처리한 메시지 ID를 메모리에 보관할 시간
RECONNECT_INTERVAL_HOURS=12           # 예방적 재연결 주기
