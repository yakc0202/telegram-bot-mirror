{
  "uid": "telegram-bot-logs",
  "title": "텔레그램 봇 로그",
  "tags": [
    "telegram-bot"
  ],
  "timezone": "Asia/Seoul",
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "schemaVersion": 41,
  "editable": true,
  "description": "봇 stderr.log (Alloy → Loki, 90일 보관). 검색어 칸에 정규식을 넣으면 아래 두 패널을 거름.",
  "templating": {
    "list": [
      {
        "type": "textbox",
        "name": "search",
        "label": "검색어",
        "query": "",
        "current": {
          "value": ""
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "등급별 로그 줄 수 (5분)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (level) (count_over_time({job=\"telegram-bot\", level=~\"WARNING|ERROR|CRITICAL\"}[5m]))",
          "legendFormat": "{{level}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "table",
      "title": "많이 나온 경고 (선택 기간)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "instant",
          "instant": true,
          "legendFormat": "{{lvl}} {{msg}}",
          "expr": "topk(15, sum by (lvl, msg) (count_over_time({job=\"telegram-bot\", level=~\"WARNING|ERROR|CRITICAL\"} | regexp \"^\\\\S+ \\\\S+ \\\\[(?P<lvl>[A-Z]+)\\\\] (?P<msg>[^\\\\n]{1,80})\" [$__range])))"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "lvl": "등급",
              "msg": "메시지",
              "Value": "건수"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "건수",
                "desc": true
              }
            ]
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "logs",
      "title": "WARNING 이상",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{job=\"telegram-bot\", level=~\"WARNING|ERROR|CRITICAL\"} |~ \"$search\""
        }
      ],
      "options": {
        "showTime": false,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      }
    },
    {
      "id": 4,
      "type": "logs",
      "title": "전체 로그",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 28
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{job=\"telegram-bot\"} |~ \"$search\""
        }
      ],
      "options": {
        "showTime": false,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      }
    }
  ]
}